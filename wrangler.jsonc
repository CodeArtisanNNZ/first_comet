{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-comet",
  "compatibility_date": "2026-10-08",
  "main": "./worker/visitor.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "VISITOR_COUNTER", "class_name": "VisitorCounter"}
    ]
  },
  "migrations": [
    {"tag": "visitor-counter-v1", "new_sqlite_classes": ["VisitorCounter"]}
  ]
}
